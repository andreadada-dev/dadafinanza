<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_quick_title"
        android:textColor="#F7F7F8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quick_widget_context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="DadaFinanza"
        android:textColor="#B9BBC2"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_widget_expense"
            style="@style/WidgetQuickButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_new_expense"
            android:text="@string/widget_expense" />
        <TextView
            android:id="@+id/quick_widget_income"
            style="@style/WidgetQuickButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_new_income"
            android:text="@string/widget_income" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/quick_widget_transfer"
            style="@style/WidgetQuickButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_new_transfer"
            android:text="@string/widget_transfer" />
        <TextView
            android:id="@+id/quick_widget_voice"
            style="@style/WidgetQuickButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_voice_description"
            android:text="@string/widget_voice" />
    </LinearLayout>
</LinearLayout>
